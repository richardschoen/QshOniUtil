/* Desc: Save Licensed Program to IFS Save File */

             PGM        PARM(&LICPGM &OPTION &RSTFROMDIR)

             DCL        VAR(&LICPGM) TYPE(*CHAR) LEN(7)
             DCL        VAR(&OPTION) TYPE(*CHAR) LEN(5)
             DCL        VAR(&RSTFROMDIR) TYPE(*CHAR) LEN(255)
             DCL        VAR(&IFSFILE) TYPE(*CHAR) LEN(255)
             DCL        VAR(&SAVFNAME) TYPE(*CHAR) LEN(10)
             DCL        VAR(&SAVF) TYPE(*CHAR) LEN(10)
             DCL        VAR(&MSG) TYPE(*CHAR) LEN(512)
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ERRORS))

/* Build save file names */
             /* Base option */
             IF         COND(&OPTION *EQ *BASE) THEN(DO)
             CHGVAR     VAR(&SAVF) VALUE('Q' |< &LICPGM |< 'BS')
             CHGVAR     VAR(&IFSFILE) VALUE(&RSTFROMDIR |< '/' |< +
                          &SAVF |< '.savf')
             ENDDO
             /* Additional numeric option */
             IF         COND(&OPTION *NE *BASE) THEN(DO)
             CHGVAR     VAR(&SAVF) VALUE('Q' |< &LICPGM |< &OPTION)
             CHGVAR     VAR(&IFSFILE) VALUE(&RSTFROMDIR |< '/' |< +
                          &SAVF |< '.savf')
             ENDDO

             /* Make sure IFS file found for save file */
             QSHONI/QSHIFSCHK FILNAM(&IFSFILE)
             /* not found. Bail out */
             MONMSG     MSGID(CPF9898) EXEC(DO)
             SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) MSGDTA('IFS +
                          save file' |> &IFSFILE |> 'not found. +
                          Restore cancelled') MSGTYPE(*ESCAPE)
             ENDDO
             /* Exists. Nothing to do */
             MONMSG     MSGID(CPF9897) EXEC(DO)
             ENDDO

             /* Create the save file in QTEMP */
             CRTSAVF    FILE(QTEMP/&SAVF) TEXT(&LICPGM |> 'option:' +
                          |> &OPTION)
             MONMSG     MSGID(CPF0000)
             /* Clear it */
             CLRSAVF    FILE(QTEMP/&SAVF)

             /* Copy IFS save file to SAVF */
             CPYFRMSTMF FROMSTMF(&IFSFILE) +
                          TOMBR('/QSYS.LIB/QTEMP.LIB/' |< &SAVF |< +
                          '.FILE') MBROPT(*REPLACE) CVTDTA(*NONE)

             /* Restore the licensed program option */
             RSTLICPGM  LICPGM(&LICPGM) DEV(*SAVF) OPTION(&OPTION) +
                          SAVF(QTEMP/&SAVF)

             CHGVAR     VAR(&MSG) VALUE('Lic program:' |> &LICPGM |> +
                          'option:' |> &OPTION |> 'restored from' |> +
                          &IFSFILE)
             SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) MSGDTA(&MSG) +
                          MSGTYPE(*COMP)
             RETURN

ERRORS:
             CHGVAR     VAR(&MSG) VALUE('Errors restoring licensed +
                          program option. Check the job log')
             SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) MSGDTA(&MSG) +
                          MSGTYPE(*ESCAPE)

             ENDPGM
